APP_NAME="VnB New Hire"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=secret

# Cache & Session (Mockup-friendly)
CACHE_STORE=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Mail Configuration
MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@vnb.wismilak.com
MAIL_FROM_NAME="VnB New Hire"

# WhatsApp Integration
WHATSAPP_PROVIDER=twilio
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_FROM_NUMBER=

# File Upload
FILESYSTEM_DISK=public
MAX_UPLOAD_SIZE=10240

# Logging
LOG_CHANNEL=stack
LOG_STACK=single

# Audit & Security
AUDIT_LOG_ENABLED=true
APP_TIMEZONE=Asia/Jakarta
